#!/usr/bin/env bash
set -euo pipefail
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
ROOT="$(cd "$(dirname "$self")/.." && pwd)"
export HERMES_SOURCE_ROOT="${HERMES_SOURCE_ROOT:-$ROOT}"
export HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
case "${1:-}" in
  update)
    shift
    exec "$ROOT/scripts/fork-update" "$@"
    ;;
  backend-start)
    shift
    exec "$ROOT/venv/bin/python" -m hermes_cli.fork_update --start-backend "$@"
    ;;
  backend-restart)
    shift
    exec "$ROOT/venv/bin/python" -m hermes_cli.fork_update --restart-backend "$@"
    ;;
  backend-launchd-install)
    shift
    exec "$ROOT/venv/bin/python" -m hermes_cli.fork_update --install-backend-launchd "$@"
    ;;
  backend-launchd-uninstall)
    shift
    exec "$ROOT/venv/bin/python" -m hermes_cli.fork_update --uninstall-backend-launchd "$@"
    ;;
  serve)
    exec "$ROOT/venv/bin/python" "$ROOT/hermes" "$@"
    ;;
esac
HERMES_WORKDIR="${HERMES_WORKDIR:-$HOME/Developer/hermes-workspace}"
if [[ -n "$HERMES_WORKDIR" ]] && [[ -d "$HERMES_WORKDIR" ]]; then
  case "$PWD" in
    "$HERMES_WORKDIR"|"$HERMES_WORKDIR/"*|"$HOME/Developer/"*) : ;;
    *)
      cd "$HERMES_WORKDIR" || {
        printf '%s\n' "hermes: cannot enter workspace $HERMES_WORKDIR from $PWD (sandbox grant?)" >&2
        exit 1
      }
      ;;
  esac
fi
unset PYTHONPATH
unset PYTHONHOME
PY=""
if [[ -x "$ROOT/venv/bin/python" ]]; then
  PY="$ROOT/venv/bin/python"
elif [[ -x "$ROOT/venv/bin/python3" ]]; then
  PY="$ROOT/venv/bin/python3"
elif [[ -x "${HERMES_HOME}/hermes-agent/venv/bin/python" ]]; then
  PY="${HERMES_HOME}/hermes-agent/venv/bin/python"
elif [[ -x "${HERMES_HOME}/hermes-agent/venv/bin/python3" ]]; then
  PY="${HERMES_HOME}/hermes-agent/venv/bin/python3"
fi
if [[ -z "$PY" ]]; then
  printf '%s\n' "hermes: python not found in $ROOT/venv" >&2
  exit 1
fi
exec "$PY" "$ROOT/hermes" "$@"
